{
  "video": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "target_duration": 32,
    "min_duration": 24,
    "max_duration": 58,
    "bitrate": "10M",
    "codec": "libx264",
    "audio_codec": "aac",
    "preset": "medium"
  },
  "voice": {
    "provider": "edge",
    "voice": "en-US-AndrewNeural",
    "rate": "-4%",
    "pitch": "-1Hz",
    "fallback_provider": "gtts",
    "fallback_voice": "en"
  },
  "music": {
    "enabled": true,
    "volume": 0.12,
    "duck_volume": 0.08
  },
  "captions": {
    "enabled": true,
    "style": "modern",
    "font_name": "Lato-Bold.ttf",
    "font_size": 42,
    "color": "#FFFFFF",
    "highlight_color": "#FFD60A",
    "stroke_color": "#000000",
    "stroke_width": 3,
    "max_words_per_line": 3,
    "position": "bottom"
  },
  "visuals": {
    "prefer_video": true,
    "max_per_provider": 8,
    "quality": "high",
    "allow_images": true,
    "ken_burns": true
  },
  "scenes": {
    "min_count": 4,
    "max_count": 8
  },
  "language": "en",
  "output_folder": "output",
  "cache_folder": "cache",
  "cleanup_temp": true
}
